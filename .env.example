# Copy to .env and fill in. Never commit the filled-in copy — .env is gitignored.
#
# On Windows, set these in PowerShell instead if you prefer:
#   $env:ARCHIVE_ROOT = "D:\drone\archive"

# ---------------------------------------------------------------------------
# Paths — stage 1, 4, and export
# ---------------------------------------------------------------------------
# Expects archive/<country>/<file>. Never written to, moved, or deleted.
ARCHIVE_ROOT=./archive
PIPELINE_DB=./pipeline.db
RENDER_ROOT=./renders
EXPORT_ROOT=./exports

# Keep these OFF a synced drive (OneDrive/Dropbox). Renders and exports of a
# 250GB archive will otherwise be uploaded to the cloud in the background.

# ---------------------------------------------------------------------------
# Stage 1b — scene detection
# ---------------------------------------------------------------------------
# High threshold on purpose: a drone push-in is one continuous move, and we
# would rather keep a file whole than chop a slow reveal into pieces.
SCENE_THRESHOLD=32.0
MIN_SHOT_SECONDS=3.0

# ---------------------------------------------------------------------------
# Stage 2 — score & filter
# ---------------------------------------------------------------------------
# Fraction of the archive flagged as rejected. Nothing is ever deleted, and
# `score --rejections-only` re-draws the bar without re-decoding a frame.
REJECT_PERCENTILE=0.35
SAMPLE_FPS=1.0
# Shots scored in parallel. Defaults to min(8, CPU cores). Lower it if the
# drive holding the archive is the bottleneck rather than the CPU.
# SCORE_WORKERS=8

# Optional. Without it, scoring runs on motion and technical quality alone and
# the weights renormalise. Path to the LAION aesthetic predictor head.
# AESTHETIC_WEIGHTS=./models/sac+logos+ava1-l14-linearMSE.pth
# CLIP_MODEL=ViT-L-14
# CLIP_PRETRAINED=openai
# TORCH_DEVICE=cuda

# ---------------------------------------------------------------------------
# Stage 3 — tag & describe  (NEEDED)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# TAG_MODEL=claude-opus-5

# ---------------------------------------------------------------------------
# Stage 4 — render
# ---------------------------------------------------------------------------
OVERLAY_TEXT=Found this.
# Required on Windows and Linux for the burned-in text; macOS falls back to a
# system font. Set the raw path — it is escaped for ffmpeg automatically.
OVERLAY_FONT=
# libx264 (small) or prores_ks (edit-friendly, very large)
LICENSING_CODEC=libx264

# ---------------------------------------------------------------------------
# Stage 5 — publish  (NEEDED)
# ---------------------------------------------------------------------------
# Same variable names the new-visu app uses, so one .env can serve both.
# sk_ followed by 64 hex characters.
ZERNIO_API_KEY=
ZERNIO_BASE_URL=https://zernio.com/api/v1
# Optional; only needed if your Zernio account has multiple profiles.
ZERNIO_PROFILE_ID=
SOCIAL_PLATFORMS=instagram,tiktok
